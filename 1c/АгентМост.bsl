// === МОДУЛЬ ОБЪЕКТА ===
// АгентМост 1.0 — файловый мост «агент <-> 1С», протокол v1.0 (PROTOCOL.md).
// Вся рабочая логика, кнопки и таймер — в МОДУЛЕ ФОРМЫ: форма внешней обработки
// не имеет гарантированной ссылки на этот модуль, а ПодключитьОбработчикОжидания
// ищет процедуру только в своём модуле.
// === МОДУЛЬ ФОРМЫ ===
// «АгентМост»: поле пути, кнопки «Запустить/Остановить мост», таймер и вся
// логика обмена по протоколу v1.0. Кодировка обмена — UTF-8 (см. PROTOCOL.md).
// ★ ЕДИНСТВЕННОЕ МЕСТО ДЛЯ ПРАВКИ ПУТИ (значение по умолчанию): "C:\1c_agent\exchange"
// Путь также можно задать полем формы «ПутьКExchange» — оно важнее значения ниже.
&НаКлиенте
Перем ИдДиалога;
&НаКлиенте
Перем ПоследняяФразаДиалога;
&НаКлиенте
Перем ТишинаСчетчикДиалога;
&НаКлиенте
Перем ОжиданиеСекунд;

&НаКлиенте
Функция УбратьБОМ(Текст) Экспорт
	Попытка
		Если Лев(Текст, 1) = Символ(65279) Тогда
			Возврат Сред(Текст, 2);
		КонецЕсли;
		Возврат Текст;
	Исключение
		Возврат Текст;
	КонецПопытки;
КонецФункции

&НаКлиенте
Функция ПрочитатьФайлТекст(ПолныйПуть) Экспорт
	Попытка
		Чт = Новый ЧтениеТекста(ПолныйПуть, КодировкаТекста.UTF8);
		Текст = Чт.Прочитать();
		Чт.Закрыть();
		Текст = УбратьБОМ(Текст);
		Возврат Текст;
	Исключение
		ВызватьИсключение "io_error: " + ОписаниеОшибки();
	КонецПопытки;
КонецФункции

&НаКлиенте
Процедура ЗаписатьТекстАтомарно(ПолныйПуть, Текст) Экспорт
	// Атомарная запись: сначала <id>.json.tmp в responses/, затем переименовать в <id>.json
	Попытка
		ВремПуть = ПолныйПуть + ".tmp";
		Зп = Новый ЗаписьТекста(ВремПуть, КодировкаТекста.UTF8);
		Зп.Записать(Текст);
		Зп.Закрыть();
		Попытка
			УдалитьФайлы(ПолныйПуть);
		Исключение
		КонецПопытки;
		ПереместитьФайл(ВремПуть, ПолныйПуть);
	Исключение
		ВызватьИсключение "io_error: " + ОписаниеОшибки();
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура Залогировать(ТекстСообщения) Экспорт
	Попытка
		КаталогЛога = ПутьКExchange + "\log";
		СоздатьКаталог(КаталогЛога);
		ИмяФайла = КаталогЛога + "\мост_" + Формат(ТекущаяДата(), "ДФ=yyyy-MM-dd") + ".log";
		Зп = Новый ЗаписьТекста(ИмяФайла, КодировкаТекста.UTF8, Символы.ПС, Истина);
		Зп.ЗаписатьСтроку(Формат(ТекущаяДата(), "ДФ='гггг-ММ-дд ЧЧ:мм:сс'") + " | " + ТекстСообщения);
		Зп.Закрыть();
	Исключение
		// Лог не должен ронять опрос очереди
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Функция ТекущаяМеткаВремени() Экспорт
	Возврат Формат(ТекущаяДата(), "ДФ='гггг-ММ-ддТЧЧ:мм:сс'");
КонецФункции

&НаКлиенте
Функция ЗначениеВJSON(Значение) Экспорт
	Попытка
		Если Значение = Неопределено Или Значение = Null Тогда
			Возврат Null;
		ИначеЕсли ТипЗнч(Значение) = Тип("Дата") Тогда
			Возврат Формат(Значение, "ДФ='гггг-ММ-дд ЧЧ:мм'");
		ИначеЕсли ТипЗнч(Значение) = Тип("Число") Тогда
			Возврат Значение;
		ИначеЕсли ТипЗнч(Значение) = Тип("Булево") Тогда
			Возврат Значение;
		Иначе
			Возврат Строка(Значение);
		КонецЕсли;
	Исключение
		Возврат Строка(Значение);
	КонецПопытки;
КонецФункции

&НаКлиенте
Функция ОчиститьНеопределено(Значение) Экспорт
	// Эта сборка 1С не сериализует Null/Неопределено в ЗаписатьJSON,
	// поэтому подменяем плейсхолдером, а после записи меняем его на null строкой.
	Попытка
		Если Значение = Неопределено Или Значение = Null Тогда
			Возврат "__AGENT_NULL_1C__";
		КонецЕсли;
		Т = ТипЗнч(Значение);
		Если Т = Тип("Структура") Тогда
			Для Каждого Эл Из Значение Цикл
				Значение[Эл.Ключ] = ОчиститьНеопределено(Эл.Значение);
			КонецЦикла;
		ИначеЕсли Т = Тип("Соответствие") Тогда
			Для Каждого Эл Из Значение Цикл
				Значение[Эл.Ключ] = ОчиститьНеопределено(Эл.Значение);
			КонецЦикла;
		ИначеЕсли Т = Тип("Массив") Тогда
			Для Сч = 0 По Значение.Количество() - 1 Цикл
				Значение[Сч] = ОчиститьНеопределено(Значение[Сч]);
			КонецЦикла;
		КонецЕсли;
	Исключение
	КонецПопытки;
	Возврат Значение;
КонецФункции

&НаКлиенте
Функция СформироватьОтвет(Ид, Статус, Результат, Ошибка) Экспорт
	Ответ = Новый Структура;
	Ответ.Вставить("protocol", "1.0");
	Ответ.Вставить("id", Ид);
	Ответ.Вставить("ts", ТекущаяМеткаВремени());
	Ответ.Вставить("status", Статус);
	Ответ.Вставить("result", Результат);
	Ответ.Вставить("error", Ошибка);
	Ответ.Вставить("executed_by", "АгентМост 1.0");
	Ответ = ОчиститьНеопределено(Ответ);
	ЗпJSON = Новый ЗаписьJSON;
	ЗпJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗпJSON, Ответ);
	ТекстОтвета = ЗпJSON.Закрыть();
	ТекстОтвета = СтрЗаменить(ТекстОтвета, """__AGENT_NULL_1C__""", "null");
	Возврат ТекстОтвета;
КонецФункции

&НаКлиенте
Функция ОшибкаСтруктура(Код, Сообщение) Экспорт
	С = Новый Структура;
	С.Вставить("code", Код);
	С.Вставить("message", Сообщение);
	Возврат С;
КонецФункции

&НаКлиенте
Функция УбратьКомментарииИзЗапроса(ТекстЗапроса) Экспорт
	// Режем // до конца строки и /* ... */
	Попытка
		Результат = "";
		ВКомментарииБлока = Ложь;
		МассивСтрок = СтрРазделить(ТекстЗапроса, Символы.ПС);
		Для Каждого Стр Из МассивСтрок Цикл
			ТекСтр = Стр;
			// блочные комментарии грубо
			Пока Найти(ТекСтр, "/*") > 0 И Найти(ТекСтр, "*/") > 0 Цикл
				Н1 = Найти(ТекСтр, "/*");
				Н2 = Найти(ТекСтр, "*/");
				Если Н2 > Н1 Тогда
					ТекСтр = Лев(ТекСтр, Н1 - 1) + Сред(ТекСтр, Н2 + 2);
				Иначе
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Поз = Найти(ТекСтр, "//");
			Если Поз > 0 Тогда
				ТекСтр = Лев(ТекСтр, Поз - 1);
			КонецЕсли;
			Результат = Результат + ТекСтр + Символы.ПС;
		КонецЦикла;
		Возврат Результат;
	Исключение
		Возврат ТекстЗапроса;
	КонецПопытки;
КонецФункции

&НаКлиенте
Функция ВыполнитьПроверкаСвязи(Команда) Экспорт
	Попытка
		Ид = Команда["id"];
		Рез = Новый Структура;
		// Глобальной функции ВерсияПлатформы в 1С нет — учебная версия 8.3
		Платф = "8.3";
		Рез.Вставить("platform", Платф);
		Рез.Вставить("bsl_version", "1.0");
		Возврат СформироватьОтвет(Ид, "ok", Рез, Null);
	Исключение
		Возврат СформироватьОтвет(Команда["id"], "error", Null, ОшибкаСтруктура("execution_error", ОписаниеОшибки()));
	КонецПопытки;
КонецФункции

&НаКлиенте
Функция ВыполнитьЗапрос1С(Команда) Экспорт
	Попытка
		Ид = Команда["id"];
		Парам = Команда["params"];
		Если Парам = Неопределено Или Парам = Null Тогда
			Возврат СформироватьОтвет(Ид, "error", Null, ОшибкаСтруктура("invalid_query", "Пустые params: нужно поле query"));
		КонецЕсли;
		ТекстЗапроса = Парам["query"];
		Если ТекстЗапроса = Неопределено Или ТекстЗапроса = Null Тогда
			Возврат СформироватьОтвет(Ид, "error", Null, ОшибкаСтруктура("invalid_query", "В params нет поля query"));
		КонецЕсли;
		ТекстЗапроса = УбратьБОМ(Строка(ТекстЗапроса));
		ТекстЗапроса = УбратьКомментарииИзЗапроса(ТекстЗапроса);
		ТекстЗапроса = СокрЛП(ТекстЗапроса);
		ВрегЗапрос = ВРег(ТекстЗапроса);
		// Должен начинаться с ВЫБРАТЬ (без учёта регистра)
		Если Лев(ВрегЗапрос, 7) <> "ВЫБРАТЬ" Тогда
			Возврат СформироватьОтвет(Ид, "error", Null, ОшибкаСтруктура("invalid_query", "Запрос должен начинаться с ВЫБРАТЬ"));
		КонецЕсли;
		// Запрещённые подстроки без учёта регистра + «;» внутри запроса
		Запрещ = Новый Массив;
		Запрещ.Добавить("ИЗМЕНИТЬ");
		Запрещ.Добавить("УДАЛИТЬ");
		Запрещ.Добавить("ЗАПИСАТЬ");
		Запрещ.Добавить("ВЫЗВАТЬ");
		Запрещ.Добавить("ДОБАВИТЬ");
		Запрещ.Добавить("DELETE");
		Запрещ.Добавить("UPDATE");
		Запрещ.Добавить("INSERT");
		Запрещ.Добавить("DROP");
		Запрещ.Добавить("ТРАНЗАКЦИЯ");
		Для Каждого З Из Запрещ Цикл
			Если Найти(ВрегЗапрос, З) > 0 Тогда
				Возврат СформироватьОтвет(Ид, "error", Null, ОшибкаСтруктура("invalid_query", "Запрещённая конструкция в запросе: " + З));
			КонецЕсли;
		КонецЦикла;
		Если Найти(ТекстЗапроса, ";") > 0 Тогда
			Возврат СформироватьОтвет(Ид, "error", Null, ОшибкаСтруктура("invalid_query", "Символ «;» внутри запроса запрещён"));
		КонецЕсли;
		// Если нет «ПЕРВЫЕ» — вставить «ПЕРВЫЕ 50» после ВЫБРАТЬ (лимит учебной версии — 2000 записей)
		Если Найти(ВрегЗапрос, "ПЕРВЫЕ") = 0 Тогда
			// Вставка ПЕРВЫЕ 50: заменяем первое вхождение ВЫБРАТЬ на ВЫБРАТЬ ПЕРВЫЕ 50
			Поз = Найти(ВрегЗапрос, "ВЫБРАТЬ");
			ДлинаВыбрать = 7;
			ТекстЗапроса = Лев(ТекстЗапроса, Поз + ДлинаВыбрать - 1) + " ПЕРВЫЕ 50 " + Сред(ТекстЗапроса, Поз + ДлинаВыбрать + 1);
		КонецЕсли;
		Попытка
			Запрос = Новый Запрос(ТекстЗапроса);
			ВыборкаТаб = Запрос.Выполнить().Выгрузить();
		Исключение
			Возврат СформироватьОтвет(Ид, "error", Null, ОшибкаСтруктура("execution_error", ОписаниеОшибки()));
		КонецПопытки;
		Попытка
			Колонки = Новый Массив;
			Для Каждого Кол Из ВыборкаТаб.Колонки Цикл
				Колонки.Добавить(Кол.Имя);
			КонецЦикла;
			Строки = Новый Массив;
			Счёт = 0;
			Усечён = Ложь;
			Для Каждого СтрТаб Из ВыборкаТаб Цикл
				Если Счёт >= 50 Тогда
					Усечён = Истина;
					Прервать;
				КонецЕсли;
				МасСтр = Новый Массив;
				Для Каждого Кол Из ВыборкаТаб.Колонки Цикл
					МасСтр.Добавить(ЗначениеВJSON(СтрТаб[Кол.Имя]));
				КонецЦикла;
				Строки.Добавить(МасСтр);
				Счёт = Счёт + 1;
			КонецЦикла;
			Рез = Новый Структура;
			Рез.Вставить("columns", Колонки);
			Рез.Вставить("rows", Строки);
			Рез.Вставить("row_count", Счёт);
			Если Усечён Тогда
				Рез.Вставить("truncated", Истина);
			КонецЕсли;
			Возврат СформироватьОтвет(Ид, "ok", Рез, Null);
		Исключение
			Возврат СформироватьОтвет(Ид, "error", Null, ОшибкаСтруктура("execution_error", ОписаниеОшибки()));
		КонецПопытки;
	Исключение
		Попытка
			Возврат СформироватьОтвет(Команда["id"], "error", Null, ОшибкаСтруктура("execution_error", ОписаниеОшибки()));
		Исключение
			Возврат "";
		КонецПопытки;
	КонецПопытки;
КонецФункции

&НаКлиенте
Функция ВыполнитьСоздатьДокумент(Команда) Экспорт
	Попытка
		Ид = Команда["id"];
		Парам = Команда["params"];
		Если Парам = Неопределено Или Парам = Null Тогда
			Возврат СформироватьОтвет(Ид, "error", Null, ОшибкаСтруктура("execution_error", "Пустые params"));
		КонецЕсли;
		// Двухступенчатая защита: confirmed_by == null -> need_confirmation, документ НЕ создавать
		Подтв = Неопределено;
		Попытка
			Подтв = Команда["confirmed_by"];
		Исключение
			Подтв = Null;
		КонецПопытки;
		Если Подтв = Неопределено Или Подтв = Null Тогда
			Эхо = Новый Структура;
			Эхо.Вставить("doc_type", Парам["doc_type"]);
			Эхо.Вставить("counterparty", Парам["counterparty"]);
			Эхо.Вставить("positions", Парам["positions"]);
			РезНужн = Новый Структура;
			РезНужн.Вставить("echo", Эхо);
			// Статус need_confirmation: человек должен подтвердить словами «да/подтверждаю»
			Возврат СформироватьОтвет(Ид, "need_confirmation", РезНужн, Null);
		КонецЕсли;
		// Подтверждено человеком: выполняем
		Попытка
			ТипДок = Строка(Парам["doc_type"]);
			Если ТипДок = "" Или ТипДок = "Неопределено" Тогда
				ТипДок = "РеализацияТоваровУслуг";
			КонецЕсли;
			МетаДок = Метаданные.Документы.Найти(ТипДок);
			Если МетаДок = Неопределено Тогда
				Возврат СформироватьОтвет(Ид, "error", Null, ОшибкаСтруктура("unsupported_doc_type", "Тип документа не найден в конфигурации: " + ТипДок));
			КонецЕсли;
			Если ТипДок <> "РеализацияТоваровУслуг" Тогда
				// По контракту поддерживаем только РеализацияТоваровУслуг
				Возврат СформироватьОтвет(Ид, "error", Null, ОшибкаСтруктура("unsupported_doc_type", "Неподдерживаемый тип документа: " + ТипДок));
			КонецЕсли;
			НаимКонтр = Строка(Парам["counterparty"]);
			КонтрагентСсылка = Неопределено;
			Попытка
				КонтрагентСсылка = Справочники.Контрагенты.НайтиПоНаименованию(НаимКонтр, Истина);
			Исключение
				КонтрагентСсылка = Неопределено;
			КонецПопытки;
			Если КонтрагентСсылка = Неопределено Или КонтрагентСсылка.Пустая() Тогда
				Возврат СформироватьОтвет(Ид, "error", Null, ОшибкаСтруктура("execution_error", "Контрагент не найден: " + НаимКонтр));
			КонецЕсли;
			НовДок = Документы.РеализацияТоваровУслуг.СоздатьДокумент();
			НовДок.Дата = ТекущаяДата();
			НовДок.Контрагент = КонтрагентСсылка;
			Позиции = Парам["positions"];
			Если Позиции <> Неопределено И Позиции <> Null Тогда
				Для Каждого Поз Из Позиции Цикл
					Попытка
						НаимНом = Строка(Поз["item"]);
						НомСсылка = Справочники.Номенклатура.НайтиПоНаименованию(НаимНом, Истина);
						Если НомСсылка = Неопределено Или НомСсылка.Пустая() Тогда
							Возврат СформироватьОтвет(Ид, "error", Null, ОшибкаСтруктура("execution_error", "Номенклатура не найдена: " + НаимНом));
						КонецЕсли;
						НовСтр = НовДок.Товары.Добавить();
						НовСтр.Номенклатура = НомСсылка;
						НовСтр.Количество = Число(Поз["qty"]);
						НовСтр.Цена = Число(Поз["price"]);
					Исключение
						Возврат СформироватьОтвет(Ид, "error", Null, ОшибкаСтруктура("execution_error", "Ошибка в позиции: " + ОписаниеОшибки()));
					КонецПопытки;
				КонецЦикла;
			КонецЕсли;
			НовДок.Записать(РежимЗаписиДокумента.Проведение);
			РезОк = Новый Структура;
			РезОк.Вставить("number", Строка(НовДок.Номер));
			РезОк.Вставить("date", Формат(НовДок.Дата, "ДФ='гггг-ММ-дд'"));
			РезОк.Вставить("posted", Истина);
			Возврат СформироватьОтвет(Ид, "ok", РезОк, Null);
		Исключение
			Возврат СформироватьОтвет(Ид, "error", Null, ОшибкаСтруктура("execution_error", ОписаниеОшибки()));
		КонецПопытки;
	Исключение
		Попытка
			Возврат СформироватьОтвет(Команда["id"], "error", Null, ОшибкаСтруктура("execution_error", ОписаниеОшибки()));
		Исключение
			Возврат "";
		КонецПопытки;
	КонецПопытки;
КонецФункции

&НаКлиенте
Функция ОбработатьКоманду(ТекстКоманды) Экспорт
	Попытка
		ТекстКоманды = УбратьБОМ(ТекстКоманды);
		ЧтJSON = Новый ЧтениеJSON;
		ЧтJSON.УстановитьСтроку(ТекстКоманды);
		Команда = ПрочитатьJSON(ЧтJSON);
		ЧтJSON.Закрыть();
	Исключение
		РезОш = СформироватьОтвет("unknown", "error", Null, ОшибкаСтруктура("parse_error", "Не разобран JSON: " + ОписаниеОшибки()));
		Возврат РезОш;
	КонецПопытки;
	Попытка
		Если Команда["protocol"] <> "1.0" Тогда
			Возврат СформироватьОтвет(Команда["id"], "error", Null, ОшибкаСтруктура("parse_error", "Неверный protocol, ожидался 1.0"));
		КонецЕсли;
		Действие = НРег(Строка(Команда["action"]));
		Если Действие = НРег("проверка_связи") Тогда
			Возврат ВыполнитьПроверкаСвязи(Команда);
		ИначеЕсли Действие = НРег("запрос_1с") Тогда
			Возврат ВыполнитьЗапрос1С(Команда);
		ИначеЕсли Действие = НРег("создать_документ") Тогда
			Возврат ВыполнитьСоздатьДокумент(Команда);
		Иначе
			Возврат СформироватьОтвет(Команда["id"], "error", Null, ОшибкаСтруктура("unsupported_action", "Неизвестное действие: " + Строка(Команда["action"])));
		КонецЕсли;
	Исключение
		Попытка
			Возврат СформироватьОтвет(Команда["id"], "error", Null, ОшибкаСтруктура("execution_error", ОписаниеОшибки()));
		Исключение
			Возврат СформироватьОтвет("unknown", "error", Null, ОшибкаСтруктура("execution_error", ОписаниеОшибки()));
		КонецПопытки;
	КонецПопытки;
КонецФункции

&НаКлиенте
Процедура ОпросОчереди() Экспорт
	// Вызывается обработчиком ожидания каждые 2 секунды, никогда не падает
	Попытка
		Если СокрЛП(Строка(ПутьКExchange)) = "" Тогда
			Залогировать("Путь к exchange не задан — пропуск опроса");
			Возврат;
		КонецЕсли;
		КаталогКоманд = ПутьКExchange + "\commands";
		КаталогОтветов = ПутьКExchange + "\responses";
		КаталогАрхива = ПутьКExchange + "\archive";
		Попытка
			СоздатьКаталог(КаталогКоманд);
		Исключение
		КонецПопытки;
		Попытка
			СоздатьКаталог(КаталогОтветов);
		Исключение
		КонецПопытки;
		Попытка
			СоздатьКаталог(КаталогАрхива);
		Исключение
		КонецПопытки;
		Файлы = НайтиФайлы(КаталогКоманд, "*.json");
		Для Каждого Файл Из Файлы Цикл
			Попытка
				Если Файл.ЭтоКаталог() Тогда
					Продолжить;
				КонецЕсли;
				ИмяБезРасш = Файл.ИмяБезРасширения;
				// Пропускаем временные файлы
				Если Прав(Файл.Имя, 4) = ".tmp" Тогда
					Продолжить;
				КонецЕсли;
				ТекстКоманды = ПрочитатьФайлТекст(Файл.ПолноеИмя);
				ОтветТекст = ОбработатьКоманду(ТекстКоманды);
				// Извлекаем id для имени файла ответа (если parse_error — пробуем вытащить грубо)
				ИдОтвета = ИмяБезРасш;
				Попытка
					Чт2 = Новый ЧтениеJSON;
					Чт2.УстановитьСтроку(УбратьБОМ(ТекстКоманды));
					К2 = ПрочитатьJSON(Чт2);
					Чт2.Закрыть();
					Если К2["id"] <> Неопределено Тогда
						ИдОтвета = Строка(К2["id"]);
					КонецЕсли;
				Исключение
				КонецПопытки;
				ПутьОтвета = КаталогОтветов + "\" + ИдОтвета + ".json";
				Попытка
					ЗаписатьТекстАтомарно(ПутьОтвета, ОтветТекст);
				Исключение
					Залогировать("io_error при записи ответа " + ИдОтвета + ": " + ОписаниеОшибки());
					Продолжить;
				КонецПопытки;
				// Определяем суффикс архива по статусу ответа
				Суффикс = "__done";
				Попытка
					Чт3 = Новый ЧтениеJSON;
					Чт3.УстановитьСтроку(ОтветТекст);
					О3 = ПрочитатьJSON(Чт3);
					Чт3.Закрыть();
					Если О3["status"] = "error" Тогда
						Суффикс = "__error";
					Иначе
						Суффикс = "__done";
					КонецЕсли;
				Исключение
					Суффикс = "__error";
				КонецПопытки;
				Попытка
					КопироватьФайл(Файл.ПолноеИмя, КаталогАрхива + "\" + ИмяБезРасш + Суффикс + ".json");
					УдалитьФайлы(Файл.ПолноеИмя);
				Исключение
					Залогировать("io_error при архивации " + ИмяБезРасш + ": " + ОписаниеОшибки());
				КонецПопытки;
			Исключение
				Попытка
					Залогировать("execution_error в ОпросОчереди: " + ОписаниеОшибки());
				Исключение
				КонецПопытки;
			КонецПопытки;
		КонецЦикла;
	Исключение
		Попытка
			Залогировать("execution_error в ОпросОчереди (верхний уровень): " + ОписаниеОшибки());
		Исключение
		КонецПопытки;
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ЗапуститьМост(Команда) Экспорт
	Попытка
		// Приоритет: поле формы (реквизит ПутьКExchange), затем значение по умолчанию (★ выше)
		Попытка
			ЗначПоля = ПутьКExchange;
			Если ЗначПоля <> Неопределено И СокрЛП(Строка(ЗначПоля)) <> "" Тогда
				ПутьКExchange = СокрЛП(Строка(ЗначПоля));
			КонецЕсли;
		Исключение
		КонецПопытки;
		ПодключитьОбработчикОжидания("ОпросОчереди", 2);
		Сообщить("Мост запущен. Опрос папки exchange каждые 2 сек: " + ПутьКExchange);
		Залогировать("Мост запущен: " + ПутьКExchange);
	Исключение
		Сообщить("Не удалось запустить мост: " + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ОстановитьМост(Команда) Экспорт
	Попытка
		ОтключитьОбработчикОжидания("ОпросОчереди");
		Сообщить("Мост остановлен.");
	Исключение
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ) Экспорт
	// ★ единственное место значения по умолчанию; поле формы важнее
		Попытка
			Если СокрЛП(Строка(ПутьКExchange)) = "" Тогда
				ПутьКExchange = "D:\agent-1c-demo\exchange";
			КонецЕсли;
		Исключение
		КонецПопытки;
		// Автозапуск опроса: кнопки команд в этой сборке 1С не отрисовываются
		// (квирк XML), поэтому мост стартует сам; остановка — закрытием формы.
		Попытка
			ПодключитьОбработчикОжидания("ОпросОчереди", 2);
			Сообщить("Мост запущен. Опрос папки exchange каждые 2 сек: " + ПутьКExchange);
		Исключение
			Сообщить("Не удалось запустить мост: " + ОписаниеОшибки());
		КонецПопытки;
		// Диалог с нейросетью: собственный таймер 1 сек — отправка по тишине, приём ответа.
		Попытка
			ПодключитьОбработчикОжидания("ПроверитьФразуДиалога", 1);
		Исключение
			Сообщить("Диалог не запустился: " + ОписаниеОшибки());
			Залогировать("chat timer error: " + ОписаниеОшибки());
		КонецПопытки;
		История = "Диалог с нейросетью (локальная модель Qwen через Ollama)." + Символы.ПС
			+ "Напишите задачу, например: «покажи задолженность контрагентов» "
			+ "или «создай накладную на ООО Ромашка 5 шт по 200»." + Символы.ПС + Символы.ПС;
		Статус = "Готов. Ответ появится здесь через 1-2 секунды после фразы.";
КонецПроцедуры

// === ДИАЛОГ С НЕЙРОСЕТЬЮ (окно прямо в 1С) ===
// Фраза из поля «Фраза» уходит файлом в exchange\chat\requests, служба
// agent/chat_service.py отвечает локальной моделью Qwen и кладёт текст в
// exchange\chat\responses. Если службы нет 20 секунд — отвечаем по правилам.


&НаКлиенте
Функция КаталогДиалога(Подкаталог) Экспорт
    Возврат ПутьКExchange + "\chat\" + Подкаталог;
КонецФункции

&НаКлиенте
Функция СтруктураВJSON(Значение) Экспорт
    З = ОчиститьНеопределено(Значение);
    ЗпJSON = Новый ЗаписьJSON;
    ЗпJSON.УстановитьСтроку();
    ЗаписатьJSON(ЗпJSON, З);
    Т = ЗпJSON.Закрыть();
    Возврат СтрЗаменить(Т, """__AGENT_NULL_1C__""", "null");
КонецФункции

&НаКлиенте
Функция ФайлСуществует(ПутьФайла) Экспорт
    Попытка
        Чт = Новый ЧтениеТекста(ПутьФайла, КодировкаТекста.UTF8);
        Чт.Закрыть();
        Возврат Истина;
    Исключение
        Возврат Ложь;
    КонецПопытки;
КонецФункции

&НаКлиенте
Процедура ДобавитьВИсторию(Кто, ТекстСтрока) Экспорт
    Попытка
        Если История = Неопределено Тогда
            История = "";
        КонецЕсли;
        История = История + Кто + ": " + СокрЛП(Строка(ТекстСтрока)) + Символы.ПС;
    Исключение
        Залогировать("chat history error: " + ОписаниеОшибки());
    КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьФразуВНейросеть(ТекстФразы) Экспорт
    Попытка
        Кат = КаталогДиалога("requests");
        СоздатьКаталог(Кат);
        ИдДиалога = Строка(Новый УникальныйИдентификатор());
        Запр = Новый Структура;
        Запр.Вставить("protocol", "1.1");
        Запр.Вставить("id", ИдДиалога);
        Запр.Вставить("ts", ТекущаяМеткаВремени());
        Запр.Вставить("phrase", ТекстФразы);
        Запр.Вставить("profile", "бухгалтер");
        Запр.Вставить("user", "Окно 1С");
        ЗаписатьТекстАтомарно(Кат + "\" + ИдДиалога + ".json", СтруктураВJSON(Запр));
        ДобавитьВИсторию("Вы", ТекстФразы);
        Статус = "Отправлено нейросети, жду ответ...";
        ОжиданиеСекунд = 0;
        ПоследняяФразаДиалога = "";
        ТишинаСчетчикДиалога = 0;
        Фраза = "";
        Залогировать("chat request " + ИдДиалога + ": " + ТекстФразы);
    Исключение
        Статус = "Ошибка отправки: " + ОписаниеОшибки();
        Залогировать("chat send error: " + ОписаниеОшибки());
    КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ЗабратьОтветДиалога() Экспорт
    Попытка
        Если ИдДиалога = Неопределено Или ИдДиалога = "" Тогда
            Возврат;
        КонецЕсли;
        ФайлОтвета = КаталогДиалога("responses") + "\" + ИдДиалога + ".json";
        Если Не ФайлСуществует(ФайлОтвета) Тогда
            Возврат;
        КонецЕсли;
        ТекстJSON = ПрочитатьФайлТекст(ФайлОтвета);
        Чт = Новый ЧтениеJSON;
        Чт.УстановитьСтроку(ТекстJSON);
        Ответ = ПрочитатьJSON(Чт);
        Чт.Закрыть();
        ДобавитьВИсторию("Агент", Строка(Ответ["answer"]));
        Если Ответ["pending"] = Истина Тогда
            Статус = "Жду вашего решения: напишите «да» или «нет».";
        Иначе
            Статус = "Готов. Можно задать следующий вопрос.";
        КонецЕсли;
        КатАрх = КаталогДиалога("archive");
        СоздатьКаталог(КатАрх);
        Попытка
            КопироватьФайл(ФайлОтвета, КатАрх + "\" + ИдДиалога + "__answer.json");
        Исключение
        КонецПопытки;
        Попытка
            УдалитьФайлы(ФайлОтвета);
        Исключение
        КонецПопытки;
        ИдДиалога = "";
    Исключение
        Залогировать("chat read error: " + ОписаниеОшибки());
    КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьФразуДиалога() Экспорт
    Попытка
        ЗабратьОтветДиалога();
        Тек = СокрЛП(Строка(Фраза));
        Если Тек = "" Тогда
            ТишинаСчетчикДиалога = 0;
            ПоследняяФразаДиалога = "";
            Возврат;
        КонецЕсли;
        Если Тек <> ПоследняяФразаДиалога Тогда
            ПоследняяФразаДиалога = Тек;
            ТишинаСчетчикДиалога = 0;
            Возврат;
        КонецЕсли;
        ТишинаСчетчикДиалога = ТишинаСчетчикДиалога + 1;
        Если ТишинаСчетчикДиалога = 2 Тогда
            ОтправитьФразуВНейросеть(Тек);
            Возврат;
        КонецЕсли;
        Если ИдДиалога <> Неопределено И ИдДиалога <> "" Тогда
            ОжиданиеСекунд = ОжиданиеСекунд + 1;
            Если ОжиданиеСекунд = 20 Тогда
                ДобавитьВИсторию("Агент", "Нейросеть не ответила за 20 секунд — отвечаю по правилам.");
                ОтветитьНаФразуМестно(Тек);
                ИдДиалога = "";
            КонецЕсли;
        КонецЕсли;
    Исключение
        Залогировать("chat tick error: " + ОписаниеОшибки());
    КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ОтветитьНаФразуМестно(ТекстФразы) Экспорт
    Попытка
        Т = НРег(ТекстФразы);
        Если Найти(Т, "связ") > 0 Тогда
            Ком = Новый Структура;
            Ком.Вставить("id", "local-" + ТекущаяМеткаВремени());
            ТекстJSON = ВыполнитьПроверкаСвязи(Ком);
            Чт = Новый ЧтениеJSON;
            Чт.УстановитьСтроку(ТекстJSON);
            О = ПрочитатьJSON(Чт);
            Чт.Закрыть();
            ЕстьСвязь = (О["status"] = "ok");
            ДобавитьВИсторию("Агент", "Без модели: связь с 1С "
                + ?(ЕстьСвязь, "есть", "нет"));
            Возврат;
        КонецЕсли;
        ДобавитьВИсторию("Агент", "Без нейросети понимаю только простые фразы. "
            + "Запустите службу: py agent\chat_service.py --exchange C:\1c_agent\exchange");
    Исключение
        ДобавитьВИсторию("Агент", "Локальный ответ не удался: " + ОписаниеОшибки());
    КонецПопытки;
КонецПроцедуры
